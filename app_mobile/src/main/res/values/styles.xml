<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/cp_yellow</item>
        <item name="colorPrimaryDark">@color/cp_bg</item>
        <item name="colorAccent">@color/cp_cyan</item>
        <item name="android:windowBackground">@color/cp_bg</item>
        <item name="android:statusBarColor">@color/cp_bg</item>
        <item name="android:navigationBarColor">@color/cp_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/cp_text</item>
        <item name="android:textColorSecondary">@color/cp_text_dim</item>
    </style>

    <style name="Theme.Cyber" parent="AppTheme" />

    <style name="Theme.Cyber.Fullscreen" parent="Theme.Cyber">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="TextAppearance.Cyber" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/cp_text</item>
    </style>

    <style name="TextAppearance.Cyber.Display" parent="TextAppearance.Cyber">
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/cp_yellow</item>
        <item name="android:fontFamily">@font/orbitron_black</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextAppearance.Cyber.Label" parent="TextAppearance.Cyber">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/cp_cyan</item>
        <item name="android:fontFamily">@font/rajdhani_regular</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.Cyber.Input" parent="TextAppearance.Cyber">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/cp_white</item>
        <item name="android:fontFamily">@font/orbitron_bold</item>
    </style>

    <style name="TextAppearance.Cyber.ButtonL" parent="TextAppearance.Cyber">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cp_on_yellow</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CyberHudPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">21dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:fontFamily">@font/rajdhani_bold</item>
        <item name="android:textColor">@color/cp_yellow</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
