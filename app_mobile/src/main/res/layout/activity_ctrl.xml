<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cyber_window">

    <View
        android:id="@+id/scanline_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/ctrl_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/cp_screen_pad"
        android:paddingEnd="@dimen/cp_screen_pad"
        android:paddingBottom="16dp">

            <!-- 2 top bar 350x50 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="返回"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    android:tint="@color/cp_yellow" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_drive_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/orbitron_bold"
                        android:singleLine="true"
                        android:text="驾驶控制 // DRIVE"
                        android:textColor="@color/cp_yellow"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_drive_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/rajdhani_regular"
                        android:singleLine="true"
                        android:textColor="@color/cp_cyan"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_wifi"
                    android:layout_width="wrap_content"
                    android:layout_height="23dp"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/orbitron_bold"
                    android:gravity="center"
                    android:minWidth="107dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="WiFi --"
                    android:textColor="@color/cp_on_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3 video window 350x150, TR cut 24 -->
            <FrameLayout
                android:id="@+id/video_box"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp">

                <com.google.android.exoplayer2.ui.PlayerView
                    android:id="@+id/player_small"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="zoom"
                    app:shutter_background_color="@color/cp_panel"
                    app:surface_type="texture_view"
                    app:use_controller="false" />

                <TextView
                    android:id="@+id/text_video_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/rajdhani_bold"
                    android:letterSpacing="0.2"
                    android:text="NO SIGNAL"
                    android:textColor="@color/cyan_60"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/video_tint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:id="@+id/video_scan"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:id="@+id/video_corner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tag_live"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/cp_red"
                    android:fontFamily="@font/rajdhani_bold"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="● LIVE  CSI 720p"
                    android:textColor="@color/cp_white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/btn_fullscreen"
                    android:layout_width="90dp"
                    android:layout_height="31dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/cp_on_yellow" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="全屏预览"
                        android:textColor="@color/cp_on_yellow"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- 4 telemetry 4 cells 83x52 gap 6 -->
            <LinearLayout
                android:id="@+id/telemetry_row"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal" />

            <!-- 5 gimbal card 350x83, BR 14 -->
            <LinearLayout
                android:id="@+id/card_gimbal"
                android:layout_width="match_parent"
                android:layout_height="83dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="摄像头云台"
                    android:textColor="@color/cp_cyan"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="62dp"
                        android:layout_height="wrap_content"
                        android:text="云台位置"
                        android:textColor="@color/cp_text_dim"
                        android:textSize="11sp" />

                    <org.mark.mobile.ui.cyber.CyberSlider
                        android:id="@+id/slider_servo"
                        android:layout_width="0dp"
                        android:layout_height="31dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/text_servo"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="end"
                        android:text="50%"
                        android:textColor="@color/cp_yellow"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btn_recenter"
                        android:layout_width="46dp"
                        android:layout_height="31dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center"
                        android:text="回中"
                        android:textColor="@color/cp_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 6 drive zone 350x200 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/btnLeft"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="原地左旋"
                        android:padding="18dp"
                        android:src="@drawable/ic_spin_ccw" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="原地左旋"
                        android:textColor="@color/cp_cyan"
                        android:textSize="11sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <org.mark.mobile.ui.cyber.OctagonJoystickView
                        android:id="@+id/joystick"
                        android:layout_width="190dp"
                        android:layout_height="190dp"
                        android:layout_gravity="center" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/btnRight"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="原地右旋"
                        android:padding="18dp"
                        android:src="@drawable/ic_spin_cw" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="原地右旋"
                        android:textColor="@color/cp_cyan"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 7 speed limit row 350x28 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:text="限速"
                    android:textColor="@color/cp_text_dim"
                    android:textSize="11sp" />

                <org.mark.mobile.ui.cyber.CyberSlider
                    android:id="@+id/slider_speed"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/text_speed"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/orbitron_bold"
                    android:gravity="end"
                    android:textColor="@color/cp_yellow"
                    android:textSize="11sp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 8 action keys 111x58 gap 8 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/btn_light"
                    layout="@layout/item_cyber_action"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/btn_horn"
                    layout="@layout/item_cyber_action"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/btn_snapshot"
                    layout="@layout/item_cyber_action"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
</FrameLayout>
