[Unit]
Description=ThingsHello Pi Java car service
Wants=car-pi-servo-pwm.service
After=network.target car-pi-servo-pwm.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@/current
ExecStart=@ROOT@/current/bin/car-pi serve --config @ROOT@/config/service.properties
SuccessExitStatus=143
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
